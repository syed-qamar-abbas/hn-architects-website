---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  width?: number;
  height?: number;
}

const { src, alt, loading = "lazy", fetchpriority = "auto", sizes = "(min-width: 900px) 50vw, 100vw", width, height } = Astro.props;
const className = Astro.props.class ?? "";
const base = src.replace(/\.(webp|avif|jpg|jpeg|png)$/i, "");
---

<picture>
  <source srcset={`${base}-small.avif 900w, ${base}.avif 1800w`} type="image/avif" sizes={sizes} />
  <source srcset={`${base}-small.webp 900w, ${base}.webp 1800w`} type="image/webp" sizes={sizes} />
  <img src={src} alt={alt} class={className} loading={loading} decoding="async" fetchpriority={fetchpriority} width={width} height={height} />
</picture>
