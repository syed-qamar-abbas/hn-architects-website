---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";
import { agencyOrganizationSchema } from "@/utils/seo";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  preloadImage?: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/og.webp",
  preloadImage = image,
  canonical = new URL(Astro.url.pathname, site.url).toString(),
  schema = [],
} = Astro.props;
const pageSchemas = Array.isArray(schema) ? schema : [schema];
const agencySchema = agencyOrganizationSchema();
const agencySchemaId = agencySchema["@id"];
const hasAgencySchema = pageSchemas.some((item) => {
  if (!item || typeof item !== "object") return false;
  const schemaItem = item as Record<string, unknown>;
  if (schemaItem["@id"] === agencySchemaId) return true;
  const graph = schemaItem["@graph"];
  return Array.isArray(graph) && graph.some((entry) => (
    entry &&
    typeof entry === "object" &&
    (entry as Record<string, unknown>)["@id"] === agencySchemaId
  ));
});
const schemas = hasAgencySchema ? pageSchemas : [...pageSchemas, agencySchema];
const preloadBase = preloadImage.replace(/\.(webp|avif|jpg|jpeg|png)$/i, "");
const canResponsivePreload = preloadImage.includes("/assets/portfolio/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    {canResponsivePreload && (
      <>
        <link rel="preload" as="image" href={`${preloadBase}-small.avif`} type="image/avif" media="(max-width: 700px)" fetchpriority="high" />
        <link rel="preload" as="image" href={`${preloadBase}.avif`} type="image/avif" media="(min-width: 701px)" fetchpriority="high" />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.url).toString()} />
    <link rel="alternate" type="application/rss+xml" title="HN Architects Insights" href="/rss.xml" />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "ynqgv228a7");
    </script>
  </head>
  <body>
    <div class="scroll-progress" data-progress></div>
    <div class="cursor" data-cursor aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <a class="floating-whatsapp magnetic" href={site.whatsapp} aria-label="Message HN Architects on WhatsApp">WhatsApp</a>
    <button class="back-top" type="button" data-back-top aria-label="Back to top">Top</button>
    <script>
      import "@/scripts/motion.js";
    </script>
  </body>
</html>
